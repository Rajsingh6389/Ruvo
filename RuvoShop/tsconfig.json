// { "extends": "expo/tsconfig.base", "compilerOptions": { "strict": true }, "include": ["**/*.ts", "**/*.tsx"] }

{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "**/*.old.tsx"
  ]
}